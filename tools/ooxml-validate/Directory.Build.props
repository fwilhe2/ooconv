<!-- Build intermediates go to .tools/ with the output, keeping the source tree clean. -->
<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../.tools/ooxml-validate-obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
